# ============================================================
# NutriDeq environment configuration
# Copy this file to legacy-php/.env and fill in real values.
# NEVER commit the real .env — it is git-ignored on purpose.
# Loaded by legacy-php/config/env.php on every request.
# ============================================================

# --- Database (Hostinger: hPanel > Databases > MySQL Databases) ---
# On Hostinger shared hosting the DB host is always "localhost".
# Database/user names are prefixed with your account ID, e.g. u123456789_...
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=u163824367_nutrideq
MYSQLUSER=u163824367_jhessyy
MYSQLPASSWORD=9|9@H3V?biF

# --- AI features (Groq) — required for AI recommendation endpoints ---
GROQ_API_KEY=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

# --- AI model selection (optional; defaults to openai/gpt-oss-20b) ---
# Stronger multilingual options on Groq: qwen/qwen3.8-27b (preview), openai/gpt-oss-120b
GROQ_MODEL=

# --- Google OAuth sign-in (optional; used by login-logout/google-callback.php) ---
# In Google Cloud Console > Credentials > OAuth client, add the redirect URI:
#   https://YOURDOMAIN.com/login-logout/google-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Application encryption key (optional; enables libs/Encryption.php) ---
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
NUTRIDEQ_ENC_KEY=

# --- External MySQL over TLS (only for cloud DBs like Aiven/TiDB; keep false on Hostinger) ---
MYSQL_SSL=false
